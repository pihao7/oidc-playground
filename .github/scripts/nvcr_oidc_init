#!/bin/sh
# nvcr_oidc_init — one script for the whole NGC keyless docker flow.
#
# Run with no arguments (or `init`) in a GitHub Actions workflow:
#   mint a GitHub OIDC ID token -> exchange it at the NGC token-exchange
#   service (RFC 8693) -> install self as the Docker credential helper
#   `docker-credential-ngc` -> wire credHelpers. After that one step,
#   docker pull/push need no docker login and store nothing.
#
# Docker spawns the installed copy under its required name; the protocol
# subcommands and the finer-grained workflow entry points are:
#   get|store|erase|list   Docker credential-helper protocol (spawned by Docker CLI)
#   exchange               mint + exchange only -> $GITHUB_ENV
#   setup                  install + wire credHelpers only
#   init                   exchange + setup (the default when no argument is given)
#
# Credential source (never stored, re-read on every invocation):
#   NGC_OIDC_ACCESS_TOKEN  short-lived OIDC-exchanged token (preferred)
#   NGC_CLI_API_KEY        long-lived API key (fallback)
#
# exchange/init inputs (environment):
#   EXCHANGE_URL       token-exchange endpoint base (the service under test)
#   NGC_ORG            NGC organization (sent as both org_id and org_name —
#                      same value; servers ignore unknown params)
#   NGC_CONNECTION_ID  OIDC connection id
#   OIDC_AUDIENCE      audience minted into the ID token (default nvcr.io);
#                      must be listed in connection.subject_audiences
#   EXCHANGE_AUDIENCE  audience form parameter (default nvcr.io — the deployed POC
#                      validates it against connection.subject_audiences and stamps
#                      it into the credential; set it to whatever the production
#                      exchange service expects)
#   ENV_VAR_NAME       env var written to $GITHUB_ENV (default NGC_OIDC_ACCESS_TOKEN)
#
# exchange/init require 'permissions: id-token: write' in the calling workflow.
# Tokens are masked and never printed.

set -eu

NGC_HOSTS="nvcr.io dev.nvcr.io stg.nvcr.io canary.nvcr.io"

do_get() {
    # docker hands the helper the ServerURL with no trailing newline (and the
    # daemon-side resolution path may use URL or JSON forms) — read all of
    # stdin and normalize, matching the Go binary's tolerance
    host=$(cat)
    case "$host" in
        '{'*) host=$(printf '%s' "$host" | sed -n 's/.*"ServerURL"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p') ;;
    esac
    host=${host#*://}
    host=${host%%/*}
    host=${host%%:*}
    for h in $NGC_HOSTS; do
        [ "$host" = "$h" ] || continue
        token="${NGC_OIDC_ACCESS_TOKEN:-${NGC_CLI_API_KEY:-}}"
        if [ -z "$token" ]; then
            echo "NGC_OIDC_ACCESS_TOKEN or NGC_CLI_API_KEY is required" >&2
            exit 1
        fi
        printf '{"ServerURL":"%s","Username":"$oauthtoken","Secret":"%s"}\n' "$host" "$token"
        return 0
    done
    printf '{}\n'
}

do_exchange() {
    : "${EXCHANGE_URL:?EXCHANGE_URL is required}"
    : "${NGC_ORG:?NGC_ORG is required}"
    : "${NGC_CONNECTION_ID:?NGC_CONNECTION_ID is required}"
    OIDC_AUDIENCE="${OIDC_AUDIENCE:-nvcr.io}"
    EXCHANGE_AUDIENCE="${EXCHANGE_AUDIENCE:-nvcr.io}"
    ENV_VAR_NAME="${ENV_VAR_NAME:-NGC_OIDC_ACCESS_TOKEN}"

    printf '%s' "$ENV_VAR_NAME" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$' || {
        echo "::error::ENV_VAR_NAME '$ENV_VAR_NAME' is not a valid environment variable name" >&2
        exit 1
    }

    if [ -z "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ] || [ -z "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]; then
        echo "::error::ACTIONS_ID_TOKEN_REQUEST_URL/_TOKEN are empty — the job needs 'permissions: id-token: write'" >&2
        exit 1
    fi

    # the mint endpoint occasionally answers transiently (observed: HTTP 504
    # "upstream request timeout" from GitHub's side, mid-job) — retry it
    mint_url="${ACTIONS_ID_TOKEN_REQUEST_URL}&audience=${OIDC_AUDIENCE}"
    code=""; body=""
    for attempt in 1 2 3; do
        resp=$(curl -sS -w '\n%{http_code}' -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
            "$mint_url") \
            || { echo "::warning::OIDC token request failed (attempt $attempt)" >&2; sleep 5; continue; }
        code=$(printf '%s' "$resp" | tail -n1)
        body=$(printf '%s' "$resp" | sed '$d')
        if [ "$code" = "200" ]; then break; fi
        echo "::warning::OIDC token request returned HTTP $code (attempt $attempt): $(printf '%s' "$body" | head -c 200)" >&2
        sleep 5
    done
    if [ "$code" != "200" ]; then
        echo "::error::OIDC token request failed after 3 attempts (last HTTP $code)" >&2
        exit 1
    fi
    id_token=$(printf '%s' "$body" | jq -er .value) \
        || { echo "::error::mint response had no .value" >&2; exit 1; }
    echo "::add-mask::$id_token"
    echo "minted ID token: ${#id_token} chars, aud=$OIDC_AUDIENCE"

    resp=$(curl -sS -w '\n%{http_code}' -X POST "$EXCHANGE_URL/oauth/token" \
        --data-urlencode "grant_type=urn:ietf:params:oauth:grant-type:token-exchange" \
        --data-urlencode "subject_token=$id_token" \
        --data-urlencode "subject_token_type=urn:ietf:params:oauth:token-type:id_token" \
        --data-urlencode "org_id=$NGC_ORG" \
        --data-urlencode "org_name=$NGC_ORG" \
        --data-urlencode "connection_id=$NGC_CONNECTION_ID" \
        --data-urlencode "audience=$EXCHANGE_AUDIENCE") \
        || { echo "::error::exchange request failed" >&2; exit 1; }
    code=$(printf '%s' "$resp" | tail -n1)
    body=$(printf '%s' "$resp" | sed '$d')
    if [ "$code" != "200" ]; then
        echo "::error::exchange returned HTTP $code: $body" >&2
        exit 1
    fi
    exchanged=$(printf '%s' "$body" | jq -er .access_token) \
        || { echo "::error::exchange response had no access_token" >&2; exit 1; }
    expires_in=$(printf '%s' "$body" | jq -r '.expires_in // ""')
    echo "::add-mask::$exchanged"

    if [ -n "${GITHUB_ENV:-}" ]; then
        echo "$ENV_VAR_NAME=$exchanged" >> "$GITHUB_ENV"
    fi
    if [ -n "${GITHUB_OUTPUT:-}" ]; then
        echo "token=$exchanged" >> "$GITHUB_OUTPUT"
        echo "expires_in=$expires_in" >> "$GITHUB_OUTPUT"
    fi
    echo "exchange OK: expires_in=${expires_in}s"
}

do_setup() {
    bin_dir="${HOME}/.docker/bin"
    config="${DOCKER_CONFIG:-${HOME}/.docker}/config.json"
    mkdir -p "$bin_dir" "$(dirname "$config")"
    cp "$0" "$bin_dir/docker-credential-ngc" && chmod 755 "$bin_dir/docker-credential-ngc"
    [ -f "$config" ] || echo '{}' > "$config"
    tmp=$(mktemp)
    for h in $NGC_HOSTS; do
        jq --arg h "$h" '.credHelpers += {($h): "ngc"}' "$config" > "$tmp" && mv "$tmp" "$config"
    done
    if [ -n "${GITHUB_PATH:-}" ]; then
        echo "$bin_dir" >> "$GITHUB_PATH"
    fi
    echo "installed $bin_dir/docker-credential-ngc; credHelpers configured in $config"
}

case "${1:-init}" in
    get)      do_get ;;
    store)    echo "store unsupported: set NGC_OIDC_ACCESS_TOKEN, skip docker login" >&2; exit 1 ;;
    erase)    exit 0 ;;
    list)     printf '{}\n' ;;
    exchange) do_exchange ;;
    setup)    do_setup ;;
    init)     do_exchange && do_setup ;;
    *)        echo "usage: $0 [get|store|erase|list|exchange|setup|init]  (default: init)" >&2; exit 1 ;;
esac
